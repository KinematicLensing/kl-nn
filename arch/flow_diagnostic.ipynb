    "def get_quantiles(axis, marginal, quantiles=[0.16, 0.84]):\n",
    "    \"\"\"Helper to find parameter values at specific quantiles via the CDF.\"\"\"\n",
    "    cdf = np.cumsum(marginal)\n",
    "    cdf /= cdf[-1] # Ensure it ends at 1.0\n",
    "    return np.interp(quantiles, cdf, axis)\n",
    "    \n",
    "def generate_grid_plot(grid_prob, param1_axis, param2_axis, labels=None, true_point=None):\n",
    "    \"\"\"\n",
    "    Generates a 2D plot with marginalized 1D histograms from a probability grid,\n",
    "    including the Maximum A Posteriori (MAP) point and optional true point.\n",
    "    It displays the values in a text box in the top-right corner.\n",
    "\n",
    "    Args:\n",
    "        grid_prob (np.ndarray): The 2D probability grid. \n",
    "                                Shape should be (N_points_P2, N_points_P1).\n",
    "        param1_axis (np.ndarray): The grid points for the first parameter (X-axis).\n",
    "        param2_axis (np.ndarray): The grid points for the second parameter (Y-axis).\n",
    "        labels (list or None): List of parameter names for axis labels.\n",
    "        true_point (list or None): [True_P1, True_P2] to plot as a reference.\n",
    "    \"\"\"\n",
    "    \n",
    "    # --- 1. Preparation and Marginalization ---\n",
    "    \n",
    "    # Find the index of the Maximum A Posteriori (MAP) point\n",
    "    map_index_flat = np.argmax(grid_prob)\n",
    "    # Convert flat index to (row, column) index (P2 index, P1 index)\n",
    "    map_index_p2, map_index_p1 = np.unravel_index(map_index_flat, grid_prob.shape)\n",
    "    \n",
    "    # Get the parameter values corresponding to the MAP index\n",
    "    map_p1 = param1_axis[map_index_p1]\n",
    "    map_p2 = param2_axis[map_index_p2]\n",
    "    \n",
    "    # Normalization and Marginalization\n",
    "    total_prob = np.sum(grid_prob)\n",
    "    normalized_prob = grid_prob / total_prob\n",
    "    \n",
    "    dx = param1_axis[1] - param1_axis[0]\n",
    "    dy = param2_axis[1] - param2_axis[0]\n",
    "    p1_marginal = np.sum(normalized_prob, axis=0) / dy \n",
    "    p2_marginal = np.sum(normalized_prob, axis=1) / dx\n",
    "\n",
    "    # Calculate 1-sigma bounds (16th and 84th percentiles)\n",
    "    p1_low, p1_high = get_quantiles(param1_axis, p1_marginal)\n",
    "    p2_low, p2_high = get_quantiles(param2_axis, p2_marginal)\n",
    "    \n",
    "    # Calculate error bars relative to MAP\n",
    "    p1_err_plus, p1_err_minus = p1_high - map_p1, map_p1 - p1_low\n",
    "    p2_err_plus, p2_err_minus = p2_high - map_p2, map_p2 - p2_low\n",
    "    \n",
    "    # Get labels for display\n",
    "    label1 = labels[0].replace('$', '').replace('\\\\', '') if labels else 'P1'\n",
    "    label2 = labels[1].replace('$', '').replace('\\\\', '') if labels else 'P2'\n",
    "\n",
    "    # --- 2. Setup the Plot Canvas ---\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 2, figsize=(7, 7), \n",
    "                             gridspec_kw={'width_ratios': [3, 1],\n",
    "                                          'height_ratios': [1, 3],\n",
    "                                          'hspace': 0.05, 'wspace': 0.05})\n",
    "\n",
    "    ax_2d = axes[1, 0]\n",
    "    ax_p1 = axes[0, 0]\n",
    "    ax_p2 = axes[1, 1]\n",
    "    ax_info = axes[0, 1] # The top-right corner subplot\n",
    "\n",
    "    # --- 3. Plotting the 2D Posterior (Bottom Left) ---\n",
    "    \n",
    "    ax_2d.contourf(param1_axis, param2_axis, normalized_prob, \n",
    "                   levels=20, cmap='viridis')\n",
    "\n",
    "    # Plot the MAP point on 2D plot\n",
    "    ax_2d.plot(map_p1, map_p2, 'x', color='red', markersize=10, \n",
    "               label='MAP', markeredgewidth=2)\n",
    "    \n",
    "    # Plot the True point on 2D plot (if provided)\n",
    "    if true_point:\n",
    "        true_p1, true_p2 = true_point\n",
    "        ax_2d.plot(true_p1, true_p2, '*', color='yellow', markersize=12, \n",
    "                   label='True Value', markeredgewidth=1)\n",
    "        ax_2d.legend(fontsize=8) \n",
    "\n",
    "    ax_2d.set_xlabel(labels[0] if labels else 'Parameter 1')\n",
    "    ax_2d.set_ylabel(labels[1] if labels else 'Parameter 2')\n",
    "    ax_2d.set_xlim(-0.1,0.1)\n",
    "    ax_2d.set_ylim(-0.1,0.1)\n",
    "    ax_2d.tick_params(direction='in')\n",
    "    \n",
    "    # --- 4. Plotting the 1D Marginal Plots (Top Left & Bottom Right) ---\n",
    "    \n",
    "    # P1 Marginal\n",
    "    ax_p1.plot(param1_axis, p1_marginal, color='blue')\n",
    "    mask1 = (param1_axis >= p1_low) & (param1_axis <= p1_high)\n",
    "    ax_p1.fill_between(param1_axis[mask1], 0, p1_marginal[mask1], color='blue', alpha=0.3)\n",
    "    ax_p1.axvline(map_p1, color='red', linestyle='--', linewidth=1)\n",
    "    if true_point:\n",
    "        ax_p1.axvline(true_point[0], color='yellow', linestyle=':', linewidth=2)\n",
    "    ax_p1.set_xlim(param1_axis.min(), param1_axis.max())\n",
    "    ax_p1.tick_params(axis='x', labelbottom=False, direction='in')\n",
    "    ax_p1.set_ylim(bottom=0)\n",
    "    ax_p1.set_yticks([])\n",
    "\n",
    "    # P2 Marginal\n",
    "    ax_p2.plot(p2_marginal, param2_axis, color='red')\n",
    "    mask2 = (param2_axis >= p2_low) & (param2_axis <= p2_high)\n",
    "    ax_p2.fill_betweenx(param2_axis[mask2], 0, p2_marginal[mask2], color='red', alpha=0.3)\n",
    "    ax_p2.axhline(map_p2, color='red', linestyle='--', linewidth=1)\n",
    "    if true_point:\n",
    "        ax_p2.axhline(true_point[1], color='yellow', linestyle=':', linewidth=2)\n",
    "    ax_p2.set_ylim(param2_axis.min(), param2_axis.max())\n",
    "    ax_p2.tick_params(axis='y', labelleft=False, direction='in')\n",
    "    ax_p2.set_xlim(left=0)\n",
    "    ax_p2.set_xticks([])\n",
    "\n",
    "    # --- 5. Annotating the Top-Right Corner (The new section) ---\n",
    "    \n",
    "    # Hide axis\n",
    "    ax_info.axis('off')\n",
    "\n",
    "    # Format the text content\n",
    "    map_text = f\"MAP:\\n{label1} = {map_p1:.3f}\\n{label2} = {map_p2:.3f}\"\n",
    "    \n",
    "    if true_point:\n",
    "        true_text = f\"True Value:\\n{label1} = {true_point[0]:.3f}\\n{label2} = {true_point[1]:.3f}\"\n",
    "        \n",
    "        # Combine the text and use different colors\n",
    "        full_text = f\"$\\mathbf{{MAP\\ (x)}}$\\n{label1}: {map_p1:.3f}\\n{label2}: {map_p2:.3f}\\n\\n$\\mathbf{{True\\ (*)}}$\\n{label1}: {true_point[0]:.3f}\\n{label2}: {true_point[1]:.3f}\"\n",
    "        \n",
    "        # Annotation using text() in the middle of the subplot\n",
    "        # Using a fixed position (0.5, 0.5) in the axes' coordinate system\n",
    "        ax_info.text(0.5, 0.5, full_text, \n",
    "                     transform=ax_info.transAxes, \n",
    "                     fontsize=10, \n",
    "                     verticalalignment='center', \n",
    "                     horizontalalignment='center',\n",
    "                     bbox=dict(boxstyle=\"round,pad=0.5\", fc=\"white\", alpha=0.7))\n",
    "\n",
    "    else:\n",
    "        # Only show MAP if true_point is not provided\n",
    "        ax_info.text(0.5, 0.5, map_text, \n",
    "                     transform=ax_info.transAxes, \n",
    "                     fontsize=10, \n",
    "                     verticalalignment='center', \n",
    "                     horizontalalignment='center',\n",
    "                     bbox=dict(boxstyle=\"round,pad=0.5\", fc=\"white\", alpha=0.7))\n",
    "        \n",
    "    plt.suptitle(\"2D Grid Posterior Plot\", y=0.95, fontsize=12)"
   ]
  },
