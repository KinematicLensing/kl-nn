    "def denormalize(samples):\n",
    "    denorm = np.empty_like(samples)\n",
    "    denorm[:, 0] = samples[:, 0]\n",
    "    for i, par in enumerate(par_ranges.values()):\n",
    "        low, high = par\n",
    "        values = samples[:, i+1]\n",
    "        values += 1\n",
    "        values *= (high-low)/2\n",
    "        values += low\n",
    "        denorm[:, i+1] = values\n",
    "    return denorm"
   ]
  },
