    "res_g1, res_g2 = np.zeros((n_i, n_s), dtype=np.float64), np.zeros((n_i, n_s), dtype=np.float64)\n",
    "high_g1, high_g2 = np.zeros((n_i, n_s), dtype=np.float64), np.zeros((n_i, n_s), dtype=np.float64)\n",
    "low_g1, low_g2 = np.zeros((n_i, n_s), dtype=np.float64), np.zeros((n_i, n_s), dtype=np.float64)"
